239,"pageHeight":1752}],"explanationSegments":[{"page":6,"src":"pdf-pages/securities-trading-practice/ch12/page-06.webp","x":60,"y":514,"width":1160,"height":110,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"封閉式基金每單位淨資產價值(NAV)為20元,而市場每單位交易價格為22元,此現象稱該封閉式基金為","optionTexts":{"1":"折價","2":"平價","3":"溢價","4":"價內"},"explanationText":"投信事業所發行之封閉式基金受益憑證,依現行規定得於集中交易市場交易流通,當市價高於淨值時為溢價,低於淨值時為折價。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"4d7f79790cd6eb7fb6f2ae229dd8fa275f3015be40e5aa882b38e38eb062e4c7","explanationSegmentsSha256":"cb9f3235baa43315822f65922c73e498e596fa82e8f111532501e1e17adde3f5"}},{"id":"securities-trading-practice-ch12-pdf-0026","bankId":"securities-trading-practice","bankTitle":"證券交易相關實務","chapterId":"第十二章","chapterTitle":"第十二章","number":26,"answer":"4","sourceFile":"證券交易相關實務-第十二章.pdf","questionSegments":[{"page":6,"src":"pdf-pages/securities-trading-practice/ch12/page-06.webp","x":164,"y":614,"width":1056,"height":111,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":6,"src":"pdf-pages/securities-trading-practice/ch12/page-06.webp","x":60,"y":715,"width":1160,"height":111,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"集中交易市場受益憑證每受益權單位十元者,以多少受益單位為一交易單位?","optionTexts":{"1":"一","2":"十","3":"一百","4":"一千"},"explanationText":"依「臺灣證券交易所股份有限公司受益憑證買賣辦法」§6規定,受益憑證以一千受益權單位為一交易單位。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"f769856def7f8eb9bfb9ce718e3ba7b31c2b9f68c67769ef5eb6aad6cc4a0cd2","explanationSegmentsSha256":"cbb0a50a4891430be10d9f954bf7635d93b3226c1822d03e3a1618e7ac356ed2"}},{"id":"securities-trading-practice-ch12-pdf-0027","bankId":"securities-trading-practice","bankTitle":"證券交易相關實務","chapterId":"第十二章","chapterTitle":"第十二章","number":27,"answer":"2","sourceFile":"證券交易相關實務-第十二章.pdf","questionSegments":[{"page":6,"src":"pdf-pages/securities-trading-practice/ch12/page-06.webp","x":165,"y":816,"width":1055,"height":157,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":6,"src":"pdf-pages/securities-trading-practice/ch12/page-06.webp","x":60,"y":963,"width":1160,"height":155,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"奉準公開發行且成立之國內封閉式證券投資信託基金,得申請其受益憑證上市之條件者,係該基金發行總額在新臺幣","optionTexts":{"1":"10億元以上","2":"20億元以上","3":"30億元以上","4":"40億元以上"},"explanationText":"依「證交所有價證券上市審查準則」§23第1項規定,凡經奉準公開發行之國內封閉式證券投資信託基金:一、其基金發行總額在新臺幣20億以上者,證交所得同意其受益憑證上市。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"e3b2cb95a45b563ae09c7e917ac095e269418718d673a04020d0879b9c6d7fc8","explanationSegmentsSha256":"95ce847ec16c8458c831fc1fdb36c759cdc72d00e89778a5e9734298bf1e82d1"}},{"id":"securities-trading-practice-ch12-pdf-0028","bankId":"securities-trading-practice","bankTitle":"證券交易相關實務","chapterId":"第十二章","chapterTitle":"第十二章","number":28,"answer":"3","sourceFile":"證券交易相關實務-第十二章.pdf","questionSegments":[{"page":6,"src":"pdf-pages/securities-trading-practice/ch12/page-06.webp","x":164,"y":1108,"width":1056,"height":158,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":6,"src":"pdf-pages/securities-trading-practice/ch12/page-06.webp","x":60,"y":1256,"width":1160,"height":157,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"境外基金募集及銷售案件,主管機關得委託以下何單位受理申請案件?","optionTexts":{"1":"證券投資信託暨顧問商業同業公會","2":"證交所","3":"集保結算所","4":"不得委託其他單位受理"},"explanationText":"依「境外基金管理辦法」§2-1第1項規定,金管會得委託臺灣集中保管結算所股份有限公司受理第二十七條之境外基金募集及銷售案件,並訂定第五十八條書件格式。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"a760d1b67e310cc7ca7a6ca80c6d96ae909c6b1d5801e598f7a6ac1f8b295ea4","explanationSegmentsSha256":"cbacb84bdd9ab4792e5faf2e693485a729b640e244e17eb87c9fd76042fe7e88"}},{"id":"securities-trading-practice-ch12-pdf-0029","bankId":"securities-trading-practice","bankTitle":"證券交易相關實務","chapterId":"第十二章","chapterTitle":"第十二章","number":29,"answer":"1","sourceFile":"證券交易相關實務-第十二章.pdf","questionSegments":[{"page":6,"src":"pdf-pages/securities-trading-practice/ch12/page-06.webp","x":167,"y":1403,"width":1053,"height":114,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":6,"src":"pdf-pages/securities-trading-practice/ch12/page-06.webp","x":60,"y":1507,"width":1160,"height":181,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"境外基金管理機構得在國內委任多少個總代理人代理其銷售基金?","optionTexts":{"1":"限一個","2":"限二個","3":"限五個","4":"沒有個數限制"},"explanationText":"依「境外基金管理辦法」§3第1項,境外基金管理機構或其指定機構應委任單一之總代理人在國內代理其基金之募集及銷售。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"3f34e2577905133199ab02d3ef780ed9bb105fc302f0ef0bc0b7ffae1a65d775","explanationSegmentsSha256":"8cdf838d9c0c7daa9e04bda4f5fe16a78b5041aea7e0970b674b1f71c7ef70be"}},{"id":"securities-trading-practice-ch12-pdf-0030","bankId":"securities-trading-practice","bankTitle":"證券交易相關實務","chapterId":"第十二章","chapterTitle":"第十二章","number":30,"answer":"4","sourceFile":"證券交易相關實務-第十二章.pdf","questionSegments":[{"page":7,"src":"pdf-pages/securities-trading-practice/ch12/page-07.webp","x":170,"y":194,"width":1050,"height":107,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":7,"src":"pdf-pages/securities-trading-practice/ch12/page-07.webp","x":60,"y":291,"width":1160,"height":112,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"境外基金之銷售機構最多得在國內代理幾個境外基金之募集與銷售？","optionTexts":{"1":"1個","2":"3個","3":"5個","4":"未有限制"},"explanationText":"參「境外基金管理辦法」§3第3項,銷售機構得在國內代理一個以上境外基金之募集及銷售。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"b76f3dc843c85dc98e67acb2b9a04cf6b92bdad0acb1ce3ceda674b614d5eabc","explanationSegmentsSha256":"db9f28abef62a1a50b0b889a6a529fa0e5f60959d7bc8d4dfb72af231065ef2d"}},{"id":"securities-trading-practice-ch12-pdf-0031","bankId":"securities-trading-practice","bankTitle":"證券交易相關實務","chapterId":"第十二章","chapterTitle":"第十二章","number":31,"answer":"4","sourceFile":"證券交易相關實務-第十二章.pdf","questionSegments":[{"page":7,"src":"pdf-pages/securities-trading-practice/ch12/page-07.webp","x":170,"y":393,"width":1050,"height":204,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":7,"src":"pdf-pages/securities-trading-practice/ch12/page-07.webp","x":60,"y":587,"width":1160,"height":157,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"境外基金機構得委任下列何機構擔任總代理人,辦理境外基金募集及銷售業務?","optionTexts":{"1":"經核准營業之證券投資信託事業","2":"經核准營業之證券投資顧問事業","3":"經核准營業之證券經紀商","4":"選項(1)(2) (3)皆是"},"explanationText":"依「境外基金管理辦法」§8,境外基金機構得委任經核准營業之證券投資信託事業、證券投資顧問事業或證券經紀商擔任總代理人,辦理境外基金募集及銷售業務。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"66c064606b336243502935971d5fb6e3f565daf7e77e49c8e4ed31754c1d286c","explanationSegmentsSha256":"1ab4b13d585cb3dc98bb1015700e08576c8ae808c221e9a2c326ef9cce51ddeb"}},{"id":"securities-trading-practice-ch12-pdf-0032","bankId":"securities-trading-practice","bankTitle":"證券交易相關實務","chapterId":"第十二章","chapterTitle":"第十二章","number":32,"answer":"4","sourceFile":"證券交易相關實務-第十二章.pdf","questionSegments":[{"page":7,"src":"pdf-pages/securities-trading-practice/ch12/page-07.webp","x":166,"y":734,"width":1054,"height":111,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":7,"src":"pdf-pages/securities-trading-practice/ch12/page-07.webp","x":60,"y":835,"width":1160,"height":250,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"境外基金需經下列何種程序後,始得募集及銷售?","optionTexts":{"1":"公會核准","2":"證交所核准","3":"公會申報生效","4":"金管會核准或申報生效"},"explanationText":"依「境外基金管理辦法」§27第1項規定,境外基金除依 §27-1(境外指數股票型基金)或§28(本辦法發布前經證券投資顧問事業提供投資顧問之境外基金)規定辦理者外,應由境外基金機構委任之總代理人填具申請(報)書並檢具所列文件送同業公會審查,轉報金管會核准或申報生效後,始得募集及銷售。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"646370416a9c797137b50bb0c32169fe2d2a0b42e685a2262233285861305024","explanationSegmentsSha256":"c6e655c61d47ad0aac3fec10d2b8abe3f62ee8570d3967036eabaa782411bd29"}},{"id":"securities-trading-practice-ch12-pdf-0033","bankId":"securities-trading-practice","bankTitle":"證券交易相關實務","chapterId":"第十二章","chapterTitle":"第十二章","number":33,"answer":"1","sourceFile":"證券交易相關實務-第十二章.pdf","questionSegments":[{"page":7,"src":"pdf-pages/securities-trading-practice/ch12/page-07.webp","x":151,"y":1075,"width":1069,"height":246,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":7,"src":"pdf-pages/securities-trading-practice/ch12/page-07.webp","x":60,"y":1311,"width":1160,"height":157,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"一般境外基金需由總代理人填具所需文件送何單位審查,再轉報何單位核准或申報生效後,始得募集及銷售","optionTexts":{"1":"證券投資信託暨顧問商業同業公會、金管會","2":"證券商業同業公會、金管會","3":"證券投資信託暨顧問商業同業公會、證交所","4":"證券商業同業公會、證交所"},"explanationText":"依「境外基金管理辦法」§27第1項規定,境外基金除依 §27-1(境外指數股票型基金)或§28(本辦法發布前經證券投資顧問事業提供投資顧問之境外基金)規定辦理者外,應由境外基金機構委任之總代理人填具申請(報)書並檢具所列文件送同業公會審查,轉報金管會核准或申報生效後,始得募集及銷售。 另依「境外基金管理辦法」§4第3項規定,前項資訊合作契約應行記載事項,由中華民國證券投資信託暨顧問商業同業公會(以下簡稱同業公會)擬訂,報經金管會核定;修正時,亦同。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"b275683a658bdf2e4620ea95c00de67eb7206b79bb487228abd53eaeaa8b7311","explanationSegmentsSha256":"35fd45a1dc454a5899201da6fa5cb0884ff9bce984b0756c5dc423bc24ded658"}},{"id":"securities-trading-practice-ch12-pdf-0034","bankId":"securities-trading-practice","bankTitle":"證券交易相關實務","chapterId":"第十二章","chapterTitle":"第十二章","number":34,"answer":"2","sourceFile":"證券交易相關實務-第十二章.pdf","questionSegments":[{"page":7,"src":"pdf-pages/securities-trading-practice/ch12/page-07.webp","x":170,"y":1458,"width":1050,"height":190,"pageWidth":1239,"pageHeight":1752},{"page":8,"src":"pdf-pages/securities-trading-practice/ch12/page-08.webp","x":170,"y":192,"width":1050,"height":158,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":8,"src":"pdf-pages/securities-trading-practice/ch12/page-08.webp","x":60,"y":340,"width":1160,"height":207,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"境外指數股票型基金需由總代理人填具所需文件送審查,再轉報核准後,始得募集及銷售,並向申請上市交易,空格之處應分別為","optionTexts":{"1":"證券商業同業公會、金管會、證交所","2":"證券投資信託暨顧問商業同業公會、金管會、證交所","3":"證券投資信託暨顧問商業同業公會、證交所、金管會","4":"證券商業同業公會、集保結算所、期交所"},"explanationText":"依「境外基金管理辦法」§27-1規定,境外指數股票型基金應由境外基金機構委任之總代理人,填具申請書並檢具下列文件送同業公會審查,轉報本會核准後,始得募集及銷售,並向證券交易所申請上市交易。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"7ed24cfab5e80646ad1714acbf14b3aa93aed70a8f6e54365bcd5c53901d678e","explanationSegmentsSha256":"8256ea65814e0496075ee6feefafeb513d9756cfed14ddddd7ed111c3df82e76"}},{"id":"securities-trading-practice-ch12-pdf-0035","bankId":"securities-trading-practice","bankTitle":"證券交易相關實務","chapterId":"第十二章","chapterTitle":"第十二章","number":35,"answer":"3","sourceFile":"證券交易相關實務-第十二章.pdf","questionSegments":[{"page":8,"src":"pdf-pages/securities-trading-practice/ch12/page-08.webp","x":158,"y":537,"width":1062,"height":206,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":8,"src":"pdf-pages/securities-trading-practice/ch12/page-08.webp","x":60,"y":733,"width":1160,"height":252,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"符合一定條件之境外基金機構,所委任之總代理人辦理境外基金募集及銷售案件採申報生效制。其境外基金募集及銷售案件,於金管會收到申報書即日起屆滿幾個營業日生效?","optionTexts":{"1":"15","2":"30","3":"45","4":"60"},"explanationText":"依「境外基金管理辦法」§27-2第1及第2項規定,境外基金機構經本會認可符合一定條件者,所委任之總代理人辦理境外基金募集及銷售案件採申報生效制。總代理人依前項規定申報境外基金募集及銷售案件,於金管會收到申報書即日起屆滿四十五個營業日生效。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"183a6d5156d15a16affd72978ec8f94a551829d73211af315bd196782b49e8f6","explanationSegmentsSha256":"f3d9eb671c3bb725bfbaf2b769f779641c947cff0240039c015d88b189d193d9"}},{"id":"securities-trading-practice-ch12-pdf-0036","bankId":"securities-trading-practice","bankTitle":"證券交易相關實務","chapterId":"第十二章","chapterTitle":"第十二章","number":36,"answer":"1","sourceFile":"證券交易相關實務-第十二章.pdf","questionSegments":[{"page":8,"src":"pdf-pages/securities-trading-practice/ch12/page-08.webp","x":158,"y":975,"width":1062,"height":112,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":8,"src":"pdf-pages/securities-trading-practice/ch12/page-08.webp","x":60,"y":1077,"width":1160,"height":114,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"投資人新申購開放式基金,可能會立即產生下列哪項費用?","optionTexts":{"1":"銷售費用","2":"轉換費用","3":"證券手續費","4":"管理費"},"explanationText":"於市場上買賣封閉式基金方會產生證券手續費,而轉換費為轉換投資標的時之費用,管理費則依持有期間由淨值中扣除。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"fe5556ee73fe19fb5ec0630b72346ec2582eef844d6528ead972c3e25e815874","explanationSegmentsSha256":"b1a33581a03939e712a859e5785b5a41f34cbf99a39229a920e13e962eb1b92a"}},{"id":"securities-trading-practice-ch12-pdf-0037","bankId":"securities-trading-practice","bankTitle":"證券交易相關實務","chapterId":"第十二章","chapterTitle":"第十二章","number":37,"answer":"4","sourceFile":"證券交易相關實務-第十二章.pdf","questionSegments":[{"page":8,"src":"pdf-pages/securities-trading-practice/ch12/page-08.webp","x":158,"y":1181,"width":1062,"height":113,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":8,"src":"pdf-pages/securities-trading-practice/ch12/page-08.webp","x":60,"y":1284,"width":1160,"height":205,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"持有達約定年限以上之後收型基金,不收取下列哪項費用?","optionTexts":{"1":"管理費","2":"保管費","3":"分銷費","4":"遞延手續費"},"explanationText":"「手續費後收級別基金」申購時不收取手續費,至買回時才依持有期間收取遞延銷售手續費,若持有期間超過約定年限,不收取遞延手續費,又多數後收型基金會向投資人另外收取由基金淨值扣除之分銷費。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"6619808e75589758f9b44814a70bf994dd8a8d1acfffee719371e22dacb0438c","explanationSegmentsSha256":"c426383ac6020ca39e471ec0c3526ef4ecf7dae6497b63483501aa0b145e25a5"}},{"id":"securities-trading-practice-ch12-pdf-0038","bankId":"securities-trading-practice","bankTitle":"證券交易相關實務","chapterId":"第十二章","chapterTitle":"第十二章","number":38,"answer":"4","sourceFile":"證券交易相關實務-第十二章.pdf","questionSegments":[{"page":8,"src":"pdf-pages/securities-trading-practice/ch12/page-08.webp","x":160,"y":1479,"width":1060,"height":207,"pageWidth":1239,"pageHeight":1752},{"page":9,"src":"pdf-pages/securities-trading-practice/ch12/page-09.webp","x":160,"y":169,"width":1060,"height":215,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":9,"src":"pdf-pages/securities-trading-practice/ch12/page-09.webp","x":60,"y":374,"width":1160,"height":549,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"證券投資信託事業所發行之指數股票型證券投資信託基金,在何種情況下,經其董事會決議並檢具規定文件,可向證交所申請,於成分證券之國外有價證券流通市場或投資標的交易市場休市期間,暫停其受益憑證在國內交易?","optionTexts":{"1":"連續五個營業日,基金成分證券之國外有價證券流通市場(或投資標的交易市場)休市,但國內集中交易市場仍交易","2":"基金可算得最近營業日之淨資產價值低於新臺幣30 億元","3":"申請日前二個營業日折溢價幅度均達3%","4":"以上皆是"},"explanationText":"依證交所「受益憑證買賣辦法」§5-1第1項規定,投信所發行之指數股票型證券投資信託基金或主動式交易所交易基金符合下列各款情形者,得提請證券投資信託事業董事會決議後,填具「暫停交易申請書」,並檢具相關文件,向本公司申請該指數股票型證券投資信託基金及其加掛ETF受益憑證或主動式交易所交易基金受益憑證, 於該基金成分證券之國外有價證券流通市場或投資標的交易市場休市期間暫停於集中交易市場交易:一、基金成分證券之國外有價證券流通市場或投資標的交易市場休市而集中交易市場仍交易之日數連續五個營業日(含)以上者。二、基金可算得最近營業日之淨資產價值低於(含)新臺幣三十億元者;或申請日前二個營業日折溢價幅度均達 3%(含)以上者。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"4020e8957a0dea3c59354b80018f92eeaacc1ad651f4b1ecd227677457b8c52f","explanationSegmentsSha256":"d4ba46a168bec7096a61f129496aa1e0e82e031061a8d9e862a1b056e1a26925"}},{"id":"securities-trading-practice-ch12-pdf-0039","bankId":"securities-trading-practice","bankTitle":"證券交易相關實務","chapterId":"第十二章","chapterTitle":"第十二章","number":39,"answer":"4","sourceFile":"證券交易相關實務-第十二章.pdf","questionSegments":[{"page":9,"src":"pdf-pages/securities-trading-practice/ch12/page-09.webp","x":153,"y":913,"width":1067,"height":261,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":9,"src":"pdf-pages/securities-trading-practice/ch12/page-09.webp","x":60,"y":1164,"width":1160,"height":66,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"發行以下哪種基金之證券投資信託事業,在符何一定條件下,可向證交所申請,於成分證券之國外有價證券流通市場或投資標的交易市場休市期間,暫停其受益憑證在國內交易?","optionTexts":{"1":"指數股票型證券投資信託基金","2":"主動式交易所交易基金受益憑證","3":"主動式交易所交易基金的加掛ETF","4":"以上皆是"},"explanationText":"依證交所「受益憑證買賣辦法」§5-1第1項規定,投信所發行之指數股票型證券投資信託基金或主動式交易所交易基金符合下列各款情形者,得提請證券投資信託事業董事會決議後,填具「暫停交易申請書」,並檢具相關文件,向本公司申請該指數股票型證券投資信託基金及其加掛ETF受益憑證或主動式交易所交易基金受益憑證, 於該基金成分證券之國外有價證券流通市場或投資標的交易市場休市期間暫停於集中交易市場交易:一、基金成分證券之國外有價證券流通市場或投資標的交易市場休市而集中交易市場仍交易之日數連續五個營業日(含)以上者。二、基金可算得最近營業日之淨資產價值低於(含)新臺幣三十億元者;或申請日前二個營業日折溢價幅度均達 3%(含)以上者。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"3c716154bca98ad04e0e8098d5a0b33723c6e0dc3773272a2c7c65da76615f84","explanationSegmentsSha256":"9edb423d174f314817e5291f02f84ab45ef629ea77dfc09545805396e45029e0"}},{"id":"securities-trading-practice-ch12-pdf-0040","bankId":"securities-trading-practice","bankTitle":"證券交易相關實務","chapterId":"第十二章","chapterTitle":"第十二章","number":40,"answer":"2","sourceFile":"證券交易相關實務-第十二章.pdf","questionSegments":[{"page":9,"src":"pdf-pages/securities-trading-practice/ch12/page-09.webp","x":140,"y":1220,"width":1080,"height":160,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":9,"src":"pdf-pages/securities-trading-practice/ch12/page-09.webp","x":60,"y":1370,"width":1160,"height":309,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"基金成分證券之國外有價證券流通市場或投資標的交易市場,係指基金投資於該市場之有價證券或投資標的,達基金淨資產價值以上。","optionTexts":{"1":"50%","2":"60%","3":"80%","4":"90%"},"explanationText":"依證交所「受益憑證買賣辦法」§5-1第3項及櫃買中心「指數股票型基金及主動式交易所交易基金受益憑證買賣辦法」§4-2第3 項規定,所稱基金成分證券之國外有價證券流通市場或投資標的交易市場,係指基金投資於該市場之有價證券或投資標的,達基金淨資產價值之60%(含)以上者。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"a4aa1f302edcff1b677f89c5cb62b9dd0f8719c6266a44a86082f04d5c84b8ce","explanationSegmentsSha256":"e7ead12bb53aa09d256f6869738334553d6363589df77c86007403814e5c6fbc"}}]}}
