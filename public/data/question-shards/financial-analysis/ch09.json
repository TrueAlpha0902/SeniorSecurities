9,"height":154,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":2,"src":"pdf-pages/financial-analysis/ch09/page-02.webp","x":60,"y":763,"width":1160,"height":70,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"甲公司產業循環為成長期,而乙公司產業循環為成熟期,資本結構相同下,則甲公司的本益比應較如何?","optionTexts":{"1":"低","2":"高","3":"相等","4":"沒影響"},"explanationText":"甲公司的成長率會較高,本益比較高。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"ed7ad16c04cd89baa5642417cbd0fad83bb24b64025af7d95c362eff082d559e","explanationSegmentsSha256":"7b7aad5a46a7f4540c3955876359c93b9b121e50a1b08dd0485af9e4fde5556b"}},{"id":"financial-analysis-ch09-pdf-0010","bankId":"financial-analysis","bankTitle":"財務分析","chapterId":"第九章","chapterTitle":"第九章","number":10,"answer":"4","sourceFile":"財務分析-第九章.pdf","questionSegments":[{"page":2,"src":"pdf-pages/financial-analysis/ch09/page-02.webp","x":175,"y":823,"width":1045,"height":113,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":2,"src":"pdf-pages/financial-analysis/ch09/page-02.webp","x":60,"y":926,"width":1160,"height":112,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"下列何者是會影響盈餘品質的因素?","optionTexts":{"1":"會計政策的選擇","2":"資產變現之風險性","3":"現金流量與盈餘關係","4":"選項(1)(2)(3)皆是"},"explanationText":"會計政策的選擇,資產變現之風險性及現金流量與盈餘關係皆是影響盈餘品質的因素。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"6ed4895b0e003782b8a60f11a663d15079cce9f0d61333088551325020fef371","explanationSegmentsSha256":"6a6ea9917799c100d8c85a63d36b60a302a7a0f42ea960adcec5aaecc8c46f17"}},{"id":"financial-analysis-ch09-pdf-0011","bankId":"financial-analysis","bankTitle":"財務分析","chapterId":"第九章","chapterTitle":"第九章","number":11,"answer":"4","sourceFile":"財務分析-第九章.pdf","questionSegments":[{"page":2,"src":"pdf-pages/financial-analysis/ch09/page-02.webp","x":174,"y":1028,"width":1046,"height":115,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":2,"src":"pdf-pages/financial-analysis/ch09/page-02.webp","x":60,"y":1133,"width":1160,"height":206,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"下列何者是影響盈餘品質的因素?","optionTexts":{"1":"會計政策之選擇","2":"任意性成本","3":"管理者操控","4":"選項(1)(2)(3)皆會有影響"},"explanationText":"選項(1)穩健的會計政策,盈餘品質較好。選項(2)有些公司盈餘高,可能是大幅縮減任意性成本所致如廣告費,日後可能有不利之影響。選項(3)管理者操控會影響盈餘波動。選項(4)正確,以上皆會有影響。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"9c4515836b0ca492f485eddd0ef8e32116ab33e1e4fceff779149ba2118ab724","explanationSegmentsSha256":"6c36153a6cc376fb6c7ec21d694a98c520d77d0960571b8a72bc86254999899b"}},{"id":"financial-analysis-ch09-pdf-0012","bankId":"financial-analysis","bankTitle":"財務分析","chapterId":"第九章","chapterTitle":"第九章","number":12,"answer":"4","sourceFile":"財務分析-第九章.pdf","questionSegments":[{"page":2,"src":"pdf-pages/financial-analysis/ch09/page-02.webp","x":174,"y":1329,"width":1046,"height":157,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":2,"src":"pdf-pages/financial-analysis/ch09/page-02.webp","x":60,"y":1476,"width":1160,"height":68,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"某公司將一批進貨,開立兩張支票,跨越兩個財務年度,為","optionTexts":{"1":"透過事件之發生或承認達到平滑之目的","2":"透過不同期間之分攤達到平滑之目的","3":"透過分類達到平滑之目的","4":"盈餘操縱"},"explanationText":"公司用不正當的手段,來修飾盈餘,則為盈餘操縱。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"535f330134e7f78d60e2d928d64cfd089dc9144a9e71f80b4a75830b9c0d8941","explanationSegmentsSha256":"5e17e7c1aebc176ab29574552cfaaff0f1d327be403a4b9c530fd0a0c0aaab08"}},{"id":"financial-analysis-ch09-pdf-0013","bankId":"financial-analysis","bankTitle":"財務分析","chapterId":"第九章","chapterTitle":"第九章","number":13,"answer":"3","sourceFile":"財務分析-第九章.pdf","questionSegments":[{"page":2,"src":"pdf-pages/financial-analysis/ch09/page-02.webp","x":172,"y":1534,"width":1048,"height":118,"pageWidth":1239,"pageHeight":1752},{"page":3,"src":"pdf-pages/financial-analysis/ch09/page-03.webp","x":172,"y":178,"width":1048,"height":116,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":3,"src":"pdf-pages/financial-analysis/ch09/page-03.webp","x":60,"y":284,"width":1160,"height":116,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"某公司股票 X1 年初之市價為$50,每年支付股利$3,預計 X1 年底股票市價$58,則該投資之預期報酬率若干?","optionTexts":{"1":"5%","2":"15%","3":"22%","4":"25%"},"explanationText":"除了市價上漲部分外,現金股利也要考慮進去。預期報酬率=($58-$50+$3)÷$50=22%","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"9a1738a07f033f5e09d78b68129d45db5f5fa189f16aa43a98d76fb49f364f77","explanationSegmentsSha256":"019c119856846a359cfbe76d8f34b659bf385c7e5d9969a6884c0e9e85d16698"}},{"id":"financial-analysis-ch09-pdf-0014","bankId":"financial-analysis","bankTitle":"財務分析","chapterId":"第九章","chapterTitle":"第九章","number":14,"answer":"3","sourceFile":"財務分析-第九章.pdf","questionSegments":[{"page":3,"src":"pdf-pages/financial-analysis/ch09/page-03.webp","x":174,"y":390,"width":1046,"height":260,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":3,"src":"pdf-pages/financial-analysis/ch09/page-03.webp","x":60,"y":640,"width":1160,"height":209,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"無塵晶圓現有本益比為30,今市場傳出幾項分析師預測,假設其他情形不變,請問以下哪一項預測,對其本益比會有負面影響?","optionTexts":{"1":"預測無塵股票的系統性風險係數會下降","2":"預測無塵的營業槓桿率下降","3":"預測無塵的每股盈餘將會繼續成長,但是成長率由原先的 25%降為20%","4":"預測無塵的財務槓桿率下降"},"explanationText":"選項(1)系統性風險係數下降代表公司受系統性風險影響變小, 獲利將更穩定。選項(2)營業槓桿率下降代表盈餘受銷售變動之影響變小,獲利和預期不會相差太遠。選項(4)財務槓桿率下降代表每股盈餘受稅前息前盈餘變動影響變小,獲利不會和預期相去太遠。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"cad5e2ff0e82ebca43a4fa05b051f724dfbedc8a2fbd5a26bf65b81b8431067a","explanationSegmentsSha256":"384b76187af3c31024d7c38b021d57a69157456f9b41993b85659f50060f1bf2"}},{"id":"financial-analysis-ch09-pdf-0015","bankId":"financial-analysis","bankTitle":"財務分析","chapterId":"第九章","chapterTitle":"第九章","number":15,"answer":"2","sourceFile":"財務分析-第九章.pdf","questionSegments":[{"page":3,"src":"pdf-pages/financial-analysis/ch09/page-03.webp","x":176,"y":839,"width":1044,"height":116,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":3,"src":"pdf-pages/financial-analysis/ch09/page-03.webp","x":60,"y":945,"width":1160,"height":113,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"在損益表上的哪一個項目最有助於預測未來的營業狀況?","optionTexts":{"1":"稅後淨利","2":"營業淨利","3":"營業毛利","4":"停業單位損益"},"explanationText":"要預測未來營運狀況應以現有之營運狀況為基礎,所以未考慮其他因素的營業淨利是最好的。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"7ad68b05c71cade3dcb0c7f8273b8488461435289eaf86b6857b7e40ada90dc3","explanationSegmentsSha256":"7b9517d6429bffe94144f8deee4933cca178ff9177ad3076933f9b1604f0bae2"}},{"id":"financial-analysis-ch09-pdf-0016","bankId":"financial-analysis","bankTitle":"財務分析","chapterId":"第九章","chapterTitle":"第九章","number":16,"answer":"4","sourceFile":"財務分析-第九章.pdf","questionSegments":[{"page":3,"src":"pdf-pages/financial-analysis/ch09/page-03.webp","x":176,"y":1048,"width":1044,"height":114,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":3,"src":"pdf-pages/financial-analysis/ch09/page-03.webp","x":60,"y":1152,"width":1160,"height":211,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"下列哪一個項目可不須在財務報表之附註中揭露?","optionTexts":{"1":"關係人交易","2":"期後事項","3":"會計政策","4":"有可能發生之或有資產"},"explanationText":"或有事項可能發生利益或損失,導致資產或負債發生,在未證實其確切結果前稱為「或有資產」或「或有負債」。企業不應認列但應附註揭露或有負債。對於或有資產,若經濟效益流人之可能性由「極少可能」或「有可能」變成「很有可能」時,則應附註揭露。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"fc168d0ea0796e7a838355f1e5d23431a839934f83ab84d3be3f2b7d7c147cec","explanationSegmentsSha256":"5bff270c84213fc7212946f3d706809853b1cbb794e5efb0a32ab935e7c4348c"}},{"id":"financial-analysis-ch09-pdf-0017","bankId":"financial-analysis","bankTitle":"財務分析","chapterId":"第九章","chapterTitle":"第九章","number":17,"answer":"1","sourceFile":"財務分析-第九章.pdf","questionSegments":[{"page":3,"src":"pdf-pages/financial-analysis/ch09/page-03.webp","x":177,"y":1353,"width":1043,"height":290,"pageWidth":1239,"pageHeight":1752},{"page":4,"src":"pdf-pages/financial-analysis/ch09/page-04.webp","x":157,"y":205,"width":1023,"height":48,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":4,"src":"pdf-pages/financial-analysis/ch09/page-04.webp","x":135,"y":243,"width":1025,"height":122,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"假設其他條件不變,並且缺少其他相關訊息時,投資人最不可能只基於以下哪一項消息,就降低其對甲公司每股盈餘的預測值?","optionTexts":{"1":"政府將大幅提高資本利得稅率","2":"一信譽卓著分析師宣告前期甲公司的經濟附加價值,其金額遠低於先前市場的預估值","3":"一信譽卓著分析師宣告前期甲公司的營業利益,其金額遠低於先前市場的預估值","4":"在環保人士抗爭聲中,政府拒絕了甲公司在蘊藏量極為豐富的礦區做深度開採的計畫"},"explanationText":"提高資本利得稅對公司盈餘不一定有影響,若公司甚少有投資活動就不會受影響。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"0caf4ba41cd8cf244d1fc9e86e1d2601df159c3ed23e878f9f9f734bd2e4d3b0","explanationSegmentsSha256":"4ec55e6f545e3cab4da275896515192c12d8bd268b98a1306cd4dd3bdaddef72"}},{"id":"financial-analysis-ch09-pdf-0018","bankId":"financial-analysis","bankTitle":"財務分析","chapterId":"第九章","chapterTitle":"第九章","number":18,"answer":"3","sourceFile":"財務分析-第九章.pdf","questionSegments":[{"page":4,"src":"pdf-pages/financial-analysis/ch09/page-04.webp","x":168,"y":355,"width":1052,"height":161,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":4,"src":"pdf-pages/financial-analysis/ch09/page-04.webp","x":60,"y":506,"width":1160,"height":115,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"上市(櫃)公司在作財務預測時,必須將以下哪些因素列入基本假設條件?甲.處分投資損失;乙.匯兌損益;丙.利率變動","optionTexts":{"1":"只有甲","2":"只有甲與乙","3":"甲、乙與丙都要列入","4":"甲、乙與丙都不要列入"},"explanationText":"判斷盈餘品質可透過盈餘的可預測性、轉換現金的可能性及被操控的可能性等因素分析。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"2d10ea2eb2146995c74d999185ad999c0a0c412210286cbefae7342fec08b9b1","explanationSegmentsSha256":"4c4df4fe0c03945f5a8b056ac2d57aa4562eac1c9413e55811828bbab9d33f1e"}},{"id":"financial-analysis-ch09-pdf-0019","bankId":"financial-analysis","bankTitle":"財務分析","chapterId":"第九章","chapterTitle":"第九章","number":19,"answer":"3","sourceFile":"財務分析-第九章.pdf","questionSegments":[{"page":4,"src":"pdf-pages/financial-analysis/ch09/page-04.webp","x":164,"y":611,"width":1056,"height":304,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":4,"src":"pdf-pages/financial-analysis/ch09/page-04.webp","x":60,"y":905,"width":1160,"height":205,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"下列對於盈餘品質評估之描述,何者不正確?","optionTexts":{"1":"品質高的盈餘應該具備忠實表達與完整性、穩定性及成長性的盈餘","2":"在複雜資本結構下,應計算二種每股盈餘,基本每股盈餘(Primary EPS)及稀釋每股盈餘(Diluted EPS)","3":"單一盈餘的數字足以分析公司現在的價值及其未來成長性","4":"基本每股盈餘及稀釋每股盈餘差別在其他具稀釋性潛在普通股之影響"},"explanationText":"單一盈餘的數字不足以分析公司現在的價值及其未來成長性,當我們分析其盈餘計算是否忠實表達並能完整反映公司所有的交易?有無人為操縱?盈餘組成內容為何?其未來成長性如何?盈餘的穩定性等等。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"121087bab740628474c80c695bd7169a4ec262ce8762f6f471a5cb5c46549dc0","explanationSegmentsSha256":"014b073ca28f3344282ce8012fe27041d0448eac830d58c857d22ea108353ee1"}},{"id":"financial-analysis-ch09-pdf-0020","bankId":"financial-analysis","bankTitle":"財務分析","chapterId":"第九章","chapterTitle":"第九章","number":20,"answer":"1","sourceFile":"財務分析-第九章.pdf","questionSegments":[{"page":4,"src":"pdf-pages/financial-analysis/ch09/page-04.webp","x":158,"y":1100,"width":1062,"height":115,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":4,"src":"pdf-pages/financial-analysis/ch09/page-04.webp","x":60,"y":1205,"width":1160,"height":67,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"下列何者預測準確性可能較高?甲.營業損益;乙.稅前損益;丙.稅後淨利","optionTexts":{"1":"甲","2":"乙","3":"丙","4":"甲、乙、丙相等"},"explanationText":"營業損益為來自經常性活動的損益,其預測準確性通常較高。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"be7daa01c18fb8d4721e185f1b0bf5da01ae2574e569063936b117a0baaa9d7c","explanationSegmentsSha256":"499f5883494ab720f7fa50919c7a919cd1ebc0907d7bf2e006c1d63a0f74c216"}},{"id":"financial-analysis-ch09-pdf-0021","bankId":"financial-analysis","bankTitle":"財務分析","chapterId":"第九章","chapterTitle":"第九章","number":21,"answer":"3","sourceFile":"財務分析-第九章.pdf","questionSegments":[{"page":4,"src":"pdf-pages/financial-analysis/ch09/page-04.webp","x":160,"y":1262,"width":1060,"height":162,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":4,"src":"pdf-pages/financial-analysis/ch09/page-04.webp","x":60,"y":1414,"width":1160,"height":63,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"某公司令海外子公司購入母公司過時滯銷之存貨,而使母公司之盈餘較實際為高,此種作法稱為","optionTexts":{"1":"盈餘平滑","2":"盈餘管理","3":"盈餘操縱","4":"盈餘預測"},"explanationText":"公司用不正當的手段,來修飾盈餘,則為盈餘操縱。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"216026cf72d0e61a534211a8e5335a274993fac15cf24a5c787bd4f63fbda2d8","explanationSegmentsSha256":"eedc0f3cb36c621c48bd6c5bb8c4d79285be07675d71d49f4de77145eaecf97f"}},{"id":"financial-analysis-ch09-pdf-0022","bankId":"financial-analysis","bankTitle":"財務分析","chapterId":"第九章","chapterTitle":"第九章","number":22,"answer":"4","sourceFile":"財務分析-第九章.pdf","questionSegments":[{"page":4,"src":"pdf-pages/financial-analysis/ch09/page-04.webp","x":161,"y":1467,"width":1059,"height":197,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":5,"src":"pdf-pages/financial-analysis/ch09/page-05.webp","x":60,"y":206,"width":1160,"height":120,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"下列對於盈餘平滑與盈餘操縱的動機之描述,何者正確?甲.吸引投資人投資;乙.提高經營管理者聲譽;丙.經營管理者為了增加薪資紅利","optionTexts":{"1":"僅甲","2":"僅乙","3":"僅丙","4":"甲、乙和丙皆是"},"explanationText":"吸引投資人投資,提高經營管理者聲譽及經營管理者為了增加薪資紅利皆是盈餘平滑與盈餘操縱的動機。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"be70f702830db3bb09f6cf1c6ba7177534dac05556548e5d2a57068d345ecd31","explanationSegmentsSha256":"7f723710a0107727ae8f8937691c8505dfea3d7b13b179bb41bcd254048c1ccb"}},{"id":"financial-analysis-ch09-pdf-0023","bankId":"financial-analysis","bankTitle":"財務分析","chapterId":"第九章","chapterTitle":"第九章","number":23,"answer":"4","sourceFile":"財務分析-第九章.pdf","questionSegments":[{"page":5,"src":"pdf-pages/financial-analysis/ch09/page-05.webp","x":182,"y":316,"width":1038,"height":161,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":5,"src":"pdf-pages/financial-analysis/ch09/page-05.webp","x":60,"y":467,"width":1160,"height":164,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"下列何者為盈餘管理或平滑的方法?","optionTexts":{"1":"透過事件之發生或承認達到平滑的目的","2":"透過不同期間之分攤達成平滑之目的","3":"透過分類達到平滑之目的","4":"選項(1)(2)(3)皆是"},"explanationText":"經過 Ronen及 Sadan 1981年的研究,所有盈餘管理或平滑的方法如下:透過事件之發生或承認達到平滑的目的,透過不同期間之分攤達成平滑之目的及透過分類達到平滑之目的。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"1ec955d82f4d449bc9debeafabc7d0962c27352e9cc7452460b03150471ab711","explanationSegmentsSha256":"13b4eef2ba39cef1957a1036639e7fec5e46d6617afd8446bed2fdcb31f22021"}},{"id":"financial-analysis-ch09-pdf-0024","bankId":"financial-analysis","bankTitle":"財務分析","chapterId":"第九章","chapterTitle":"第九章","number":24,"answer":"1","sourceFile":"財務分析-第九章.pdf","questionSegments":[{"page":5,"src":"pdf-pages/financial-analysis/ch09/page-05.webp","x":178,"y":621,"width":1042,"height":164,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":5,"src":"pdf-pages/financial-analysis/ch09/page-05.webp","x":60,"y":775,"width":1160,"height":114,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"如果一家公開上市公司因廠房失火而產生火災損失,它應該在其財務報表上揭露甚麼?","optionTexts":{"1":"每股稅後淨利","2":"每股火災損失","3":"每股稅後淨利與每股火災損失之差額","4":"選項(1)(2)(3)皆是"},"explanationText":"公司應該在其財務報表上揭露選項(1)每股稅後淨利,在進行未來盈餘預估時,建議將此類非常續性損益項目的影響排除之。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"3ee4bfc9aa39e098d34eeae5dcf9d60624cbf375be2a897adf721faf41f023f0","explanationSegmentsSha256":"490fe18c9b6391c9f965e920fd5f725846377f0b27300e02f7dfb7a90132930f"}},{"id":"financial-analysis-ch09-pdf-0025","bankId":"financial-analysis","bankTitle":"財務分析","chapterId":"第九章","chapterTitle":"第九章","number":25,"answer":"4","sourceFile":"財務分析-第九章.pdf","questionSegments":[{"page":5,"src":"pdf-pages/financial-analysis/ch09/page-05.webp","x":182,"y":879,"width":1038,"height":211,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":5,"src":"pdf-pages/financial-analysis/ch09/page-05.webp","x":60,"y":1080,"width":1160,"height":66,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"下列對於每股盈餘之描述,何者正確?","optionTexts":{"1":"係指公司之普通股每股在一財務年度中所賺得之盈餘","2":"可用來評估公司之獲利能力,其資訊常是投資決策的重要依據","3":"不同年度之每股盈餘的變動可代表公司獲利之趨勢","4":"選項(1)(2)(3)皆是"},"explanationText":"以上對於每股盈餘之描述皆正確。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"1c680e6ff401178ae3aeebe7926e5265fa89440ac3c451496634a3406d596d30","explanationSegmentsSha256":"260901467aef303f96da50eb18bf2739fca7f7959b6e667f80488320a2071688"}},{"id":"financial-analysis-ch09-pdf-0026","bankId":"financial-analysis","bankTitle":"財務分析","chapterId":"第九章","chapterTitle":"第九章","number":26,"answer":"4","sourceFile":"財務分析-第九章.pdf","questionSegments":[{"page":5,"src":"pdf-pages/financial-analysis/ch09/page-05.webp","x":180,"y":1136,"width":1040,"height":254,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":5,"src":"pdf-pages/financial-analysis/ch09/page-05.webp","x":60,"y":1380,"width":1160,"height":69,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"對於作盈餘預測,如果已經有綜合損益表、現金流量表、資產負債表與權益變動表在手邊,哪些有可能有增額或邊際資訊內涵 (Incremental Information Content)?甲.年度經營報告書;乙.財務報表附註資料;丙.公司負責人致股東函","optionTexts":{"1":"僅乙、丙","2":"僅甲","3":"僅甲、丙","4":"甲、乙、丙"},"explanationText":"甲、乙、丙皆能提供額外之公司經營資訊予投資人參考。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"427699c36f7d7a79eb35e905bec502b78d73325e593d9c384f32f320afa54359","explanationSegmentsSha256":"88960fd851ed6ee333827eae4fa9a44bca7438da56abc65c4755a76aec2e3d86"}},{"id":"financial-analysis-ch09-pdf-0027","bankId":"financial-analysis","bankTitle":"財務分析","chapterId":"第九章","chapterTitle":"第九章","number":27,"answer":"4","sourceFile":"財務分析-第九章.pdf","questionSegments":[{"page":5,"src":"pdf-pages/financial-analysis/ch09/page-05.webp","x":183,"y":1439,"width":1037,"height":249,"pageWidth":1239,"pageHeight":1752},{"page":6,"src":"pdf-pages/financial-analysis/ch09/page-06.webp","x":183,"y":189,"width":1037,"height":115,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":6,"src":"pdf-pages/financial-analysis/ch09/page-06.webp","x":60,"y":294,"width":1160,"height":207,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"基於以下哪一項假設性的消息,投資人可能會調高其對善化商業銀行盈餘預測值?","optionTexts":{"1":"中時頭條:經建會預測明年起國內經濟成長將趨緩","2":"善化銀行月刊頭條:會計師陳君指出:「為了顧及帳務處理的簡便,在沒有違反重要性原則的前提下,去年度善化銀行有幾項資本支出被逕行列記為費用」","3":"工商頭條:央行宣佈大幅調升貼現率","4":"經濟頭條:存款準備率下限將進一步降低"},"explanationText":"選項(1)經濟成長趨緩則公司之盈餘成長可能也會稍緩。選項 (2)費用小小增加對整個公司無太大影響。選項(3)央行調升貼現率使銀行貼現成本提高,盈餘下降。選項(4)降低存款準備率使銀行資金可以更靈活運用在其他投資,獲利可望增加。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"231df7990d58129b1478be5c9c18374bcf57a873636a04efe18472f827d259c1","explanationSegmentsSha256":"17faa77f06f4d1eaaa50eae474cab0443e4316dc38715cb34c5615134a463156"}},{"id":"financial-analysis-ch09-pdf-0028","bankId":"financial-analysis","bankTitle":"財務分析","chapterId":"第九章","chapterTitle":"第九章","number":28,"answer":"3","sourceFile":"財務分析-第九章.pdf","questionSegments":[{"page":6,"src":"pdf-pages/financial-analysis/ch09/page-06.webp","x":157,"y":491,"width":1063,"height":208,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":6,"src":"pdf-pages/financial-analysis/ch09/page-06.webp","x":60,"y":689,"width":1160,"height":116,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"在缺少其他相關訊息時,基於以下哪一項新聞報導,投資人最不可能調低其對天山企業盈餘預測值?","optionTexts":{"1":"上游廠商宣佈未來將大幅減少產量","2":"下游廠商宣佈未來將大幅減少產量","3":"競爭廠商宣佈未來將大幅減少產量","4":"天山企業宣佈未來將大幅減少產量"},"explanationText":"競爭對手減產則公司之銷售可望增加,投資人不太可能調降盈餘預測。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"bd7b8b9daa2c8343cec01675c8f0facdc0ea4bb77318e38b717389c73a5715ff","explanationSegmentsSha256":"d04faa817ddb0141bc5fb5c17b5c908e07bd125c1ce6a4cf8c9eac2a1f5970f3"}},{"id":"financial-analysis-ch09-pdf-0029","bankId":"financial-analysis","bankTitle":"財務分析","chapterId":"第九章","chapterTitle":"第九章","number":29,"answer":"2","sourceFile":"財務分析-第九章.pdf","questionSegments":[{"page":6,"src":"pdf-pages/financial-analysis/ch09/page-06.webp","x":156,"y":795,"width":1064,"height":250,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":6,"src":"pdf-pages/financial-analysis/ch09/page-06.webp","x":60,"y":1035,"width":1160,"height":114,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"在缺少其他相關訊息時,基於以下哪一項消息,投資人會立即調高其對永康電腦未來各季營業利益的預測值?甲.永康電腦下游大廠施行JIT,決定採行原料零庫存政策;乙.永康電腦下游大廠決定採行成品零庫存政策;丙.永康電腦上游大廠決定採行成品零庫存政策","optionTexts":{"1":"甲、乙與丙都對","2":"甲、乙與丙都不對","3":"僅甲對","4":"僅甲與丙對"},"explanationText":"甲、乙、丙中都只是永康公司及其上下游廠改變存貨管理制度,對其營業利益可正可負。","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"63815b0f4a93e3c1138abc8c1910c7384afc1361fa0e8995616e99ce2240be57","explanationSegmentsSha256":"4a0af213f148dd16e80cd5692a19782da470752198604f47736ed6d1123c88f0"}},{"id":"financial-analysis-ch09-pdf-0030","bankId":"financial-analysis","bankTitle":"財務分析","chapterId":"第九章","chapterTitle":"第九章","number":30,"answer":"3","sourceFile":"財務分析-第九章.pdf","questionSegments":[{"page":6,"src":"pdf-pages/financial-analysis/ch09/page-06.webp","x":154,"y":1139,"width":1066,"height":295,"pageWidth":1239,"pageHeight":1752}],"explanationSegments":[{"page":6,"src":"pdf-pages/financial-analysis/ch09/page-06.webp","x":60,"y":1424,"width":1160,"height":69,"pageWidth":1239,"pageHeight":1752}],"answerMask":null,"questionText":"大橋企業欲對其下一年度的營業額作預測,以下何者是最好的答案?","optionTexts":{"1":"其預估市場總規模將成長15%,營業額將成長15%,故市場估有率將成長15%","2":"其預估市場總規模將成長15%,營業額將成長 15%,故市場佔有率將成長32%","3":"其預估市場總規模將成長15%, 市場佔有率將成長15%,故營業額將成長32%","4":"其預估市場總規模將成長15%,市場佔有率將成長15%,故營業額將成長15%"},"explanationText":"(1+15%)×(1+15%)=1.32,1.32-1=0.32=32%","textSource":{"kind":"project-scan-pages-only","questionSegmentsSha256":"f8dbe74e64d162425898ff4fb676769f9c3aa3d3cf61f711cb4ccc1f955573dc","explanationSegme