{
  "name": "ipad-quiz-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "import:docx": "tsx scripts/import-docx-batch.ts",
    "apply:pdf-answers": "tsx scripts/apply-pdf-answers.ts",
    "approve:batch": "tsx scripts/approve-batch.ts",
    "validate:data": "tsx scripts/validate-question-bank.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "test:calculator": "tsx scripts/test-calculator-core.ts",
    "test:learning": "tsx scripts/test-learning-engine.ts",
    "test:storage": "tsx scripts/test-user-scoped-storage.ts",
    "test:daily-plan": "tsx scripts/test-daily-plan-service.ts",
    "generate:plan-index": "tsx scripts/generate-daily-plan-index.ts",
    "generate:mobile-segments": "python scripts/generate-mobile-segment-candidates.py",
    "test:mobile-segments": "tsx scripts/test-mobile-segments.ts",
    "test:mock-exam": "tsx scripts/test-mock-exam.ts",
    "test:plan-index": "tsx scripts/generate-daily-plan-index.ts --check",
    "test:bundle": "tsx scripts/check-bundle-budget.ts",
    "activation:code": "tsx scripts/generate-activation-code.ts",
    "dev:admin": "npx vercel dev",
    "predev": "npm run generate:shards && npm run generate:plan-index",
    "prebuild": "npm run generate:shards && npm run generate:plan-index",
    "verify": "npm run validate:image-data && npm run test:shards && npm run test:plan-index && npm run test:mobile-segments && npm run test:mock-exam && npm run typecheck && npm run typecheck:api && npm run lint && npm run test:css && npm run test:calculator && npm run test:learning && npm run test:storage && npm run test:reliability && npm run test:integrity && npm run test:admin && npm run test:crop-editor && npm run test:daily-plan && npm run test:recovery && npm run validate:data && npm run build && npm run test:bundle",
    "test:recovery": "tsx scripts/test-app-recovery.ts",
    "generate:shards": "tsx scripts/generate-question-shards.ts",
    "test:shards": "tsx scripts/generate-question-shards.ts --check",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "postdeploy:health": "tsx scripts/post-deploy-health-check.ts",
    "test:reliability": "tsx scripts/test-reliability-store.ts",
    "test:integrity": "tsx scripts/test-integrity-contracts.ts",
    "validate:image-data": "tsx scripts/validate-image-quiz-data.ts",
    "test:css": "tsx scripts/check-css-budget.ts",
    "test:admin": "tsx scripts/test-admin-console-contracts.ts",
    "test:crop-editor": "tsx scripts/test-pdf-crop-editor.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.53.0",
    "@vercel/analytics": "^2.0.1",
    "idb": "^8.0.2",
    "lucide-react": "^1.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "ts-fsrs": "5.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.2.0",
    "mammoth": "^1.9.1",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.1"
  }
