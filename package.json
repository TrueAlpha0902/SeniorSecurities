{
  "name": "ipad-quiz-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "import:docx": "tsx scripts/import-docx-batch.ts",
    "apply:pdf-answers": "tsx scripts/apply-pdf-answers.ts",
    "approve:batch": "tsx scripts/approve-batch.ts",
    "validate:data": "tsx scripts/validate-question-bank.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "test:calculator": "tsx scripts/test-calculator-core.ts",
    "test:learning": "tsx scripts/test-learning-engine.ts",
    "activation:code": "tsx scripts/generate-activation-code.ts",
    "dev:admin": "npx vercel dev",
    "verify": "npm run typecheck && npm run typecheck:api && npm run lint && npm run test:calculator && npm run test:learning && npm run test:storage && npm run test:daily-plan && npm run validate:data && npm run build",
    "test:storage": "tsx scripts/test-user-scoped-storage.ts",
    "test:daily-plan": "tsx scripts/test-daily-plan-service.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.53.0",
    "@vercel/analytics": "^2.0.1",
    "idb": "^8.0.2",
    "lucide-react": "^1.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "ts-fsrs": "5.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^24.0.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "mammoth": "^1.9.1",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.1"
  }
